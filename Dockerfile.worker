FROM node:22-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production
ENV LEITURAVERSO_WORKER_URL=http://127.0.0.1:3030
ENV LEITURAVERSO_WORKER_DELAY_SECONDS=5

# Nenhuma porta e publicada. O servidor auxiliar fica somente dentro do container.
CMD ["node","scripts/leituraverso-worker.mjs"]
